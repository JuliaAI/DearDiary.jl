# Copy to .env and edit. Each value below is the default. Lines starting with # are
# ignored; an empty value is read as empty, not as the default, so delete a line to keep
# its default.

# REST API
DEARDIARY_HOST=127.0.0.1
DEARDIARY_PORT=9000
DEARDIARY_DB_FILE=deardiary.db
DEARDIARY_CORS_ORIGINS=*

# Authentication. Set a strong random secret before enabling.
DEARDIARY_ENABLE_AUTH=false
DEARDIARY_JWT_SECRET=deardiary_secret

# Artifact storage: inline, filesystem, or s3
DEARDIARY_ARTIFACT_BACKEND=inline
# DEARDIARY_ARTIFACT_FS_ROOT=/path/to/deardiary_artifacts
# DEARDIARY_ARTIFACT_S3_BUCKET=
# DEARDIARY_ARTIFACT_S3_ENDPOINT=
# DEARDIARY_ARTIFACT_S3_REGION=us-east-1
# DEARDIARY_ARTIFACT_S3_ACCESS_KEY=
# DEARDIARY_ARTIFACT_S3_SECRET_KEY=

# Web dashboard
DEARDIARY_ENABLE_UI=true
DEARDIARY_UI_HOST=127.0.0.1
DEARDIARY_UI_PORT=9001
